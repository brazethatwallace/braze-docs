# Copy to .jira.env and add your Atlassian API token. Never commit .jira.env.
# Create a token: https://id.atlassian.com/manage-profile/security/api-tokens
# Used by scripts/salesforce-analyzer/sf_kb_jira_ticket.py and sf_kb_phase2_run_batches.py --open-pr
JIRA_USER_EMAIL=you@braze.com
JIRA_API_TOKEN=
JIRA_BASE_URL=https://jira.atl.braze.com
