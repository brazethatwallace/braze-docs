{
	"trailingSlash": false,
	"redirects": [
		{
			"source": "/unlisted_docs/assets/:path*",
			"destination": "/docs/assets/unlisted_docs/:path*",
			"permanent": true
		},
		{
			"source": "/unlisted_docs/:path*",
			"destination": "/docs/:path*",
			"permanent": true
		}
	],
	"rewrites": [
		{
			"source": "/docs/en/:path*",
			"destination": "/:path*"
		},
		{
			"source": "/docs/ko/:path*",
			"destination": "/:path*"
		},
		{
			"source": "/docs/es/:path*",
			"destination": "/:path*"
		},
		{
			"source": "/docs/fr/:path*",
			"destination": "/:path*"
		},
		{
			"source": "/docs/pt-br/:path*",
			"destination": "/:path*"
		},
		{
			"source": "/docs/:path*",
			"destination": "/:path*"
		},
		{
			"source": "/api/llms.txt",
			"destination": "/api/llms.txt"
		},
		{
			"source": "/api/llms-full.txt",
			"destination": "/api/llms-full.txt"
		},
		{
			"source": "/api/:path*/index.md",
			"destination": "/api/:path*/index.md"
		},
		{
			"source": "/api/((?!llms\\.txt|llms-full\\.txt|.*/index\\.md$).*)",
			"destination": "/api/404.html"
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800, s-maxage=604800, stale-while-revalidate=86400, stale-if-error=86400"
				}
			]
		}
	]
}
